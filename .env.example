# Server-side only. Set these in Vercel > Project > Settings > Environment Variables.
# Never prefix with NEXT_PUBLIC_ (that would ship them to the browser).
# AI: set ONE. Gemini is used if both are set (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ORS_API_KEY=
# Optional model overrides
GEMINI_MODEL=
CLAUDE_MODEL=
